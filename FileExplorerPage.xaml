<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FSHE.FileExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FSHE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FolderIconBrushConverter x:Key="FolderIconBrushConverter" />
        <local:FolderAccentBrushConverter x:Key="FolderAccentBrushConverter" />
        <local:TagBrushConverter x:Key="TagBrushConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Page.Transitions>
        <TransitionCollection>
            <EntranceThemeTransition FromVerticalOffset="12" />
        </TransitionCollection>
    </Page.Transitions>

    <Border
        Margin="0,0,12,42">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 列头 ===== -->
        <Border
            Grid.Row="0"
            Margin="12,6,12,0"
            BorderBrush="{StaticResource FsheStrokeBrush}"
            BorderThickness="0,0,0,1"
            Padding="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="SelectAllBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Checked="SelectAllBox_Changed"
                    Unchecked="SelectAllBox_Changed" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SortHeader_Click"
                    Padding="0"
                    Tag="Name">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="名称" />
                        <TextBlock
                            x:Name="NameSortGlyph"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{StaticResource FsheAccentBrush}"
                            Text="&#x25B2;" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="文件标签" />
                <Button
                    Grid.Column="3"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SortHeader_Click"
                    Padding="0"
                    Tag="Date">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="修改日期" />
                        <TextBlock x:Name="DateSortGlyph" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource FsheAccentBrush}" Text="&#x25B2;" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="4"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SortHeader_Click"
                    Padding="0"
                    Tag="Type">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="类型" />
                        <TextBlock x:Name="TypeSortGlyph" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource FsheAccentBrush}" Text="&#x25B2;" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Margin="0,0,6,0"
                    HorizontalContentAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SortHeader_Click"
                    Padding="0"
                    Tag="Size">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="大小" />
                        <TextBlock x:Name="SizeSortGlyph" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource FsheAccentBrush}" Text="&#x25B2;" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 内容 ===== -->
        <Grid Grid.Row="1" Margin="0,2,0,0">

            <!-- 详细信息 -->
            <ListView
                x:Name="DetailsList"
                Margin="12,0,12,0"
                IsItemClickEnabled="False"
                SelectionMode="Extended"
                ItemContainerStyle="{StaticResource FileRowStyle}"
                DoubleTapped="ItemContainer_DoubleTapped"
                SelectionChanged="ItemList_SelectionChanged"
                KeyDown="ItemsControl_KeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                Grid.Column="0"
                                AutomationProperties.Name="{Binding Name}"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel Grid.Column="1" Margin="0,0,8,0" Orientation="Horizontal" Spacing="10">
                                <Image
                                    VerticalAlignment="Center"
                                    Width="16"
                                    Height="16"
                                    Source="{Binding IconSource}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{Binding FileTag, Converter={StaticResource TagBrushConverter}}"
                                Text="{Binding FileTag}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Opacity="0.75"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding DateModified}" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Opacity="0.75"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding TypeDisplay}"
                                TextTrimming="CharacterEllipsis" />
                            <Grid
                                Grid.Column="5"
                                Margin="0,0,6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{Binding IsDirectory, Converter={StaticResource FolderAccentBrushConverter}}"
                                    Text="{Binding SizeDisplay}"
                                    Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="FolderSize_Click"
                                    Content="{Binding SizeDisplay}"
                                    FontSize="12"
                                    Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 列表 -->
            <ListView
                x:Name="SimpleList"
                Margin="12,0,12,0"
                Visibility="Collapsed"
                IsItemClickEnabled="False"
                SelectionMode="Extended"
                ItemContainerStyle="{StaticResource FileRowStyle}"
                DoubleTapped="ItemContainer_DoubleTapped"
                SelectionChanged="ItemList_SelectionChanged"
                KeyDown="ItemsControl_KeyDown">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="16,5" Orientation="Horizontal" Spacing="10">
                            <Image
                                VerticalAlignment="Center"
                                Width="16"
                                Height="16"
                                Source="{Binding IconSource}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 大图标 -->
            <GridView
                x:Name="ItemsGrid"
                Margin="16,0,16,0"
                Visibility="Collapsed"
                IsItemClickEnabled="False"
                SelectionMode="Extended"
                DoubleTapped="ItemContainer_DoubleTapped"
                SelectionChanged="ItemList_SelectionChanged"
                KeyDown="ItemsControl_KeyDown">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="108" Padding="6,10" Spacing="6">
                            <Image
                                HorizontalAlignment="Center"
                                Width="48"
                                Height="48"
                                Source="{Binding IconSource}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 空状态 -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Glyph="&#xED25;"
                    Opacity="0.4" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="此文件夹是空的" />
                <TextBlock
                    x:Name="EmptyStateHint"
                    HorizontalAlignment="Center"
                    Opacity="0.45"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="没有与搜索匹配的项目" />
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Page>
