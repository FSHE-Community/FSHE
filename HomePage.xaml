<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FSHE.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="28,22,20,24"
            MaxWidth="1100"
            HorizontalAlignment="Left"
            Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon VerticalAlignment="Center" FontSize="10" Glyph="&#xE70E;" Opacity="0.8" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="驱动器" />
            </StackPanel>
            <ItemsRepeater x:Name="DrivesList">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinColumnSpacing="10"
                        MinItemWidth="260"
                        MinRowSpacing="10"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Width="260"
                            Padding="12,10"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource FsheSurfaceBrush}"
                            BorderBrush="{StaticResource FsheStrokeBrush}"
                            BorderThickness="1"
                            Click="DriveCard_Click"
                            CornerRadius="8"
                            Tag="{Binding Root}"
                            ToolTipService.ToolTip="{Binding ToolTipText}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image
                                    Width="32"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    Source="{Binding Icon}" />
                                <StackPanel Width="186" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{Binding Label}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        Height="4"
                                        Maximum="1"
                                        Foreground="{Binding BarBrush}"
                                        Value="{Binding UsedFraction}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{Binding SpaceText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
